# Skopiuj do .env.public, chmod 600. Nie używaj z lokalnym compose.yaml.
MONIVEX_DOMAIN=monitoring.example.com
MONIVEX_ACME_EMAIL=admin@example.com
# Wygeneruj: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MONIVEX_SETUP_TOKEN=
# Wygeneruj: openssl rand -base64 32 | tr '/+' '_-'
# Zachowaj ten sam klucz przez aktualizacje; obejmuje również sekrety TOTP.
MONIVEX_ENCRYPTION_KEY=
# Dopuszczaj wyłącznie adresy monitorowanych przez Ciebie usług. Pusta lista blokuje sieciowe kontrole.
MONIVEX_ALLOWED_NETWORKS=
MONIVEX_WORKER_CONCURRENCY=10
