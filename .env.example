# Wygeneruj poza repozytorium: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MONIVEX_SETUP_TOKEN=
MONIVEX_PUBLIC_ORIGIN=http://localhost:8080
MONIVEX_PORT=8080
MONIVEX_BIND_ADDRESS=127.0.0.1
# Dla lokalnego HTTP ustaw false. Przy HTTPS bezwzględnie true.
MONIVEX_COOKIE_SECURE=true

# Lista CIDR oddzielona przecinkami. Pusta lista blokuje kontrole sieciowe.
# Ustaw wyłącznie podsieci, do których masz uprawnienia. Heartbeat działa bez listy.
MONIVEX_ALLOWED_NETWORKS=
MONIVEX_WORKER_CONCURRENCY=10
# Wymagany do konfiguracji 2FA oraz zapisu sekretów HTTP. Zachowaj go przy aktualizacjach i kopiach.
# Wygeneruj 32 bajty base64url, np. openssl rand -base64 32 | tr '/+' '_-'
MONIVEX_ENCRYPTION_KEY=
